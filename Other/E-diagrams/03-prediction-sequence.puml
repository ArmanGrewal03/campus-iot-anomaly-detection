@startuml Prediction Sequence
!theme plain

title Prediction Sequence Diagram

actor Client
participant "Model API\n:8001" as ModelAPI
participant "Random Forest\nModel" as Model
participant "Model Metadata" as Metadata

Client -> ModelAPI: POST /predict\n{data: [{features...}]}
activate ModelAPI

ModelAPI -> ModelAPI: Load Model & Metadata\nfrom models/ directory
activate ModelAPI

ModelAPI -> Metadata: Load feature_names\nLoad model metadata
activate Metadata
Metadata --> ModelAPI: Feature Names List\nModel Config
deactivate Metadata

ModelAPI -> Model: Load Model\njoblib.load()
activate Model
Model --> ModelAPI: Trained Model Object
deactivate Model

ModelAPI -> ModelAPI: Prepare Input Data\nReorder features to match\nFill missing with 0

ModelAPI -> Model: model.predict_proba(data)
activate Model
Model --> ModelAPI: Predictions & Probabilities
deactivate Model

ModelAPI -> ModelAPI: Format Results\n0 = Safe, 1 = Unsafe

ModelAPI --> Client: 200 OK\n{predictions: [...],\nprobabilities: [...],\nsafe_count: N,\nunsafe_count: M}
deactivate ModelAPI

@enduml
