@startuml WebSocket Flow
!theme plain

title WebSocket Data Stream Flow

participant "Client" as Client
participant "Model API\n:8001" as ModelAPI
participant "Feature Names\nJSON" as Features
participant "Random Data\nGenerator" as Generator
database "websocket_data.db" as DB

Client -> ModelAPI: WebSocket Connect\nws://127.0.0.1:8001/ws/data-stream
activate ModelAPI

ModelAPI -> Features: Load feature_names.json\n(196 features)
activate Features
Features --> ModelAPI: Feature List
deactivate Features

ModelAPI -> ModelAPI: Initialize Database\nCREATE TABLE websocket_data
ModelAPI -> DB: Create Table
activate DB
DB --> ModelAPI: Table Created
deactivate DB

loop Every 20-60 seconds (random)
  ModelAPI -> Generator: generate_random_data(features)
  activate Generator
  Generator --> ModelAPI: Random Data Dict\n(196 features)
  deactivate Generator
  
  ModelAPI -> ModelAPI: Create Timestamp\nGet Current Time
  
  ModelAPI -> DB: INSERT INTO websocket_data\n(timestamp, data)
  activate DB
  DB --> ModelAPI: Inserted ID
  deactivate DB
  
  ModelAPI -> Client: Send JSON\n{id, timestamp, data}
  activate Client
  Client --> Client: Receive & Process Data
  deactivate Client
end

Client -> ModelAPI: Disconnect
ModelAPI --> Client: Connection Closed
deactivate ModelAPI

note right of Generator
  Generates realistic values:
  - dur: 0.0-1000.0
  - proto/service/state: categorical
  - proto_*, state_*, service_*: one-hot
  - Numeric features: random ranges
end note

note right of DB
  Table Structure:
  - id (PRIMARY KEY)
  - timestamp (TEXT)
  - data (TEXT JSON)
end note

@enduml
