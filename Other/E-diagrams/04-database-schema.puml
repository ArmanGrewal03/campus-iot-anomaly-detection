@startuml Database Schema
!theme plain
skinparam linetype ortho

title Database Schema - SQLite Tables

package "campus_iot_data.db" {
  entity "csv_data" {
    * **id** : INTEGER <<PK>>
    --
    upload_timestamp : TEXT
    row_data : TEXT
    T : TEXT <<nullable>>
    --
    Stores CSV upload data
    T field: "training" or "testing"
  }

  entity "inserted_data" {
    * **id** : INTEGER <<PK>>
    --
    created_timestamp : TEXT
    data : TEXT
    --
    Stores JSON data from POST /insert
  }
}

package "websocket_data.db" {
  entity "websocket_data" {
    * **id** : INTEGER <<PK>>
    --
    timestamp : TEXT
    data : TEXT
    --
    Stores real-time generated data
    from WebSocket stream
  }
}

note right of csv_data
  Example row_data JSON:
  {
    "dur": 0.1,
    "proto": "tcp",
    "service": "http",
    "label": 0,
    ...
  }
end note

note right of inserted_data
  Flexible schema:
  data field contains
  any JSON structure
end note

note right of websocket_data
  Generated every 20-60 seconds
  Contains all 196 features
  from feature_names.json
end note

@enduml
